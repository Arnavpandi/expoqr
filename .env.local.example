# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key (public, safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SECRET — server-side only: API routes + feedback script)
SUPABASE_SERVICE_ROLE_KEY=

# ── WAHA (self-hosted WhatsApp HTTP API) ─────────────────────────────────────
# Base URL of your WAHA instance, e.g. http://localhost:3000 or https://waha.example.com
WAHA_URL=
# API key set via WAHA_API_KEY env var on the WAHA container
WAHA_API_KEY=
# WAHA session name that is connected to WhatsApp (default: "default")
WAHA_SESSION=default

# ── Staff access (dashboard + gate scanner) ────────────────────────────────
# Shared secret for /dashboard?key=… and /scan?key=… (server checks ADMIN_KEY).
# Anyone with the key can view visitor data and check people in — keep it private.
ADMIN_KEY=
